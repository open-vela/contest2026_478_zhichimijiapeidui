CONFIG_EXAMPLES_MIBOT_AGENT=y
CONFIG_EXAMPLES_MIBOT_AGENT_UART="/dev/ttyS0"
CONFIG_EXAMPLES_MIBOT_AGENT_BAUD=1000000
CONFIG_EXAMPLES_MIBOT_AGENT_PROGNAME="mibot_agent"
CONFIG_EXAMPLES_MIBOT_AGENT_FB="/dev/fb0"
CONFIG_EXAMPLES_MIBOT_AGENT_AUDIO=y
CONFIG_EXAMPLES_MIBOT_AGENT_AUDIO_HW=y
CONFIG_EXAMPLES_SF32_AUDIO_TEST=y
CONFIG_EXAMPLES_AUDIO_PBT=y
