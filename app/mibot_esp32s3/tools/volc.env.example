# 火山引擎语音凭证(供 volc_gateway.py 读取,勿提交入库)
# 用法:改完存成同目录 volc.env(与 volc_gateway.py 同目录),脚本自动读取。
#
# 两种鉴权风格填任意一套即可,脚本会自动识别(AAA 优先):
#
# --- 风格 A:BigModel 大模型语音(新,推荐)---
# 控制台 => 语音技术 => 应用管理,开通「大模型语音识别/语音合成」后
# 生成一个独立 API Key(形如 xxxx-xxxx-xxxx)。只需要填这一个。
VOLC_API_KEY=

# --- 风格 B:经典语音技术(旧 AK/SK)---
# 控制台 => 语音技术 => 应用管理,可见 AppID;密钥管理里拿 AccessToken/Secret
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
VOLC_CLUSTER=volcano_tts        # 经典合成用;识别为 volcano_conv / volcano_streaming_common
VOLC_ASR_CLUSTER=volcano_streaming_common

# ---- 模型/质量开关(一般不改)----
VOLC_TTS_VOICE_ID=zh_female_yuanmengengine_bigtts     # 合成音色
VOLC_ASR_MODEL=bigmodel                          # ASR 模型:bigmodel 或 volcano(A=B只支持bigmodel)
VOLC_ASR_API=combined                            # bigmodel+volcano 任选有触发:bigmodel / volcano
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration   # 大模型流式识别:时长版 duration / 并发版 concurrent