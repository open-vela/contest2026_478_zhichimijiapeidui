// Copy to mibot_secrets.h for a local build. Never commit real credentials.
#define MIBOT_WIFI_STA_SSID "replace-with-your-ssid"
#define MIBOT_WIFI_STA_PASSWORD "replace-with-your-password"

// Cloud audio gateway (ASR + TTS) reached over WebSocket.
//   wss://... for production, ws://<pc-ip>:8765 for the local mock in
//   tools/mock_cloud_audio.py.  Leave empty to disable the cloud audio path.
#define MIBOT_CLOUD_WS_URI "wss://replace-with-your-gateway.example/v1/audio"
#define MIBOT_CLOUD_API_KEY "replace-me"

// Cloud LLM: Xiaomi MiMo (OpenAI Chat Completions compatible).
// This is NOT the same key as MIBOT_CLOUD_API_KEY above (that one is for the
// WebSocket audio gateway).  Mixing them up yields 401 "Invalid API Key".
//
// MiMo has two independent billing schemes with DIFFERENT keys AND DIFFERENT
// hosts.  Using the right key against the wrong host is a 401, so pick a row:
//
//   key prefix | base URL
//   -----------+-----------------------------------------------
//   sk-xxxxx   | https://api.xiaomimimo.com/v1            (pay-as-you-go, code default)
//   tp-xxxxx   | https://token-plan-cn.xiaomimimo.com/v1  (Token Plan subscription)
//
// See https://mimo.mi.com/docs/en-US/tokenplan/Token%20Plan/quick-access
#define MIBOT_MIMO_API_KEY "replace-me"

// Uncomment for a Token Plan (tp-) key; leave commented for a pay-as-you-go
// (sk-) key, whose host is already the code default.
// #define MIBOT_LLM_URL "https://token-plan-cn.xiaomimimo.com/v1/chat/completions"
// #define MIBOT_LLM_MODEL "mimo-v2.5-pro"
// #define MIBOT_LLM_SYSTEM_PROMPT "你是MiMo（中文名称也是MiMo），是小米公司研发的AI智能助手。"
